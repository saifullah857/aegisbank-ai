# Copy to .env — NEVER commit .env. Every value below is a placeholder.
POSTGRES_USER=aegis
POSTGRES_DB=aegisbank
POSTGRES_PASSWORD=             # required, choose a strong password
JWT_SECRET=                    # required, >= 32 chars:  python -c "import secrets;print(secrets.token_urlsafe(48))"
ENVIRONMENT=production         # "development" relaxes the JWT-secret check (local only)
GROQ_API_KEY=                  # optional — leave empty to run the deterministic fallback
GROQ_MODEL=llama-3.3-70b-versatile
SEED_ON_START=true             # seed 1,000 synthetic customers / ~10k transactions on first start
